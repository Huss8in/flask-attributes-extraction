{
  "endpoints": {
    "1_category_classify": {
      "url": "POST http://localhost:6002/api/category/classify",
      "description": "Single item classification",
      "sample_input": {
        "item_name": "Nike Air Max Running Shoes",
        "description": "Comfortable running shoes with air cushioning",
        "item_department": "Footwear",
        "vendor_category": "fashion"
      }
    },
    "2_category_classify_csv": {
      "url": "POST http://localhost:6002/api/category/classify-csv",
      "description": "Process CSV file from path",
      "sample_input": {
        "csv_path": "D:/path/to/your/products.csv"
      },
      "note": "CSV must have column 'Item (EN)'. Optional: 'Description (EN)', 'Category/Department (EN)', 'Vendor Category'"
    },
    "3_category_classify_batch": {
      "url": "POST http://localhost:6002/api/category/classify-batch",
      "description": "Parallel batch classification",
      "sample_input": {
        "items": [
          {
            "item_name": "Samsung Galaxy S23",
            "description": "Latest smartphone with 5G",
            "item_department": "Mobile Phones",
            "vendor_category": "electronics"
          },
          {
            "item_name": "Chocolate Cake",
            "description": "Delicious chocolate layer cake",
            "item_department": "Bakery",
            "vendor_category": "groceries"
          },
          {
            "item_name": "Blue Cotton T-Shirt",
            "description": "Casual men's t-shirt",
            "item_department": "Clothing",
            "vendor_category": "fashion"
          }
        ],
        "max_workers": 3
      }
    },
    "4_attributes_extract": {
      "url": "POST http://localhost:6002/api/attributes/extract",
      "description": "Extract AI attributes for a single item",
      "sample_input": {
        "item_name": "Women's Red Cotton Dress",
        "description": "Elegant summer dress with floral pattern",
        "vendor_category": "fashion",
        "shopping_category": "fashion",
        "shopping_subcategory": "casual wear",
        "item_category": "dress",
        "images": []
      },
      "note": "For fashion: item_category must match the fashion mapping keys (e.g. top, dress, trousers, shoe, bag). For home and garden / beauty: the template is looked up by shopping_subcategory (e.g. drinkware, tableware, skincare). Images are optional URL strings."
    },
    "5_attributes_extract_batch": {
      "url": "POST http://localhost:6002/api/attributes/extract-batch",
      "description": "Parallel batch AI attribute extraction",
      "sample_input": {
        "items": [
          {
            "item_name": "Women's Red Cotton Dress",
            "description": "Elegant summer dress with floral pattern",
            "vendor_category": "fashion",
            "shopping_category": "fashion",
            "shopping_subcategory": "casual wear",
            "item_category": "dress",
            "images": []
          },
          {
            "item_name": "Men's Classic Denim Jeans",
            "description": "Straight-fit classic denim jeans in dark blue wash",
            "vendor_category": "fashion",
            "shopping_category": "fashion",
            "shopping_subcategory": "casual wear",
            "item_category": "trousers",
            "images": []
          },
          {
            "item_name": "Abstract Blonde Mug",
            "description": "Multi-colored shimmering mug fusing abstract art with metallic luster. Base of yellowish-beige glazing with random infused shades of yellow, blue, green, metallic red and gold.",
            "vendor_category": "",
            "shopping_category": "home and garden",
            "shopping_subcategory": "drinkware",
            "item_category": "mug",
            "images": []
          },
          {
            "item_name": "Face Cream SPF 50",
            "description": "Moisturizing face cream with sun protection",
            "vendor_category": "beauty",
            "shopping_category": "beauty",
            "shopping_subcategory": "skincare",
            "item_category": "face care",
            "images": []
          }
        ],
        "max_workers": 3
      },
      "note": "Template lookup is category-aware: fashion uses item_category, home and garden and beauty use shopping_subcategory. All template fields are always returned — empty string for attributes the model could not infer."
    },
    "6_description_generate": {
      "url": "POST http://localhost:6002/api/description/generate",
      "description": "Generate product description for items without descriptions",
      "sample_input": {
        "item_name": "Blue Cotton T-Shirt",
        "item_department": "Men's Clothing",
        "variant_name": "Large"
      },
      "sample_output": {
        "success": true,
        "description": "This classic blue cotton t-shirt offers comfortable everyday wear with a relaxed fit. Made from soft, breathable cotton fabric, it's perfect for casual occasions and pairs easily with jeans or shorts."
      },
      "note": "item_name is required. item_department and variant_name are optional but recommended for better descriptions."
    },
    "7_description_generate_with_attributes": {
      "url": "POST http://localhost:6002/api/description/generate",
      "description": "Generate description with optional AI attributes (color, material, style, etc.)",
      "sample_input": {
        "item_name": "Summer Dress",
        "item_department": "Women's Clothing",
        "variant_name": "Medium",
        "ai_attributes": {
          "color": "red",
          "material": "silk",
          "style": "elegant",
          "pattern": "solid"
        }
      },
      "sample_output": {
        "success": true,
        "description": "This elegant red silk summer dress features a flattering silhouette perfect for warm weather occasions. The luxurious silk fabric drapes beautifully and offers a sophisticated look for any event."
      },
      "note": "ai_attributes is optional. You can pass any attributes like color, material, style, pattern, size, etc."
    },
    "8_description_generate_batch": {
      "url": "POST http://localhost:6002/api/description/generate-batch",
      "description": "Parallel batch description generation",
      "sample_input": {
        "items": [
          {
            "item_name": "Blue Cotton T-Shirt",
            "item_department": "Men's Clothing",
            "variant_name": "Large"
          },
          {
            "item_name": "Leather Handbag",
            "item_department": "Accessories",
            "variant_name": "Brown",
            "ai_attributes": {
              "color": "brown",
              "material": "leather"
            }
          },
          {
            "item_name": "Wooden Coffee Table",
            "item_department": "Furniture",
            "variant_name": "Oak Finish",
            "ai_attributes": {
              "material": "wood",
              "style": "modern"
            }
          }
        ],
        "max_workers": 3
      },
      "sample_output": {
        "success": true,
        "results": [
          {
            "success": true,
            "description": "This classic blue cotton t-shirt offers comfortable everyday wear..."
          },
          {
            "success": true,
            "description": "This sophisticated brown leather handbag combines style and functionality..."
          },
          {
            "success": true,
            "description": "This elegant modern wooden coffee table features a beautiful oak finish..."
          }
        ],
        "total_items": 3,
        "successful_generations": 3,
        "failed_generations": 0,
        "processing_time": "00:00:05",
        "processing_time_seconds": 5.23
      },
      "note": "Processes multiple items in parallel. ai_attributes is optional for each item. max_workers controls parallel execution (default: 3)"
    },
    "9_grammar_check_single": {
      "url": "POST http://localhost:6002/api/grammar/check",
      "description": "Grammar check for single text",
      "sample_input": {
        "text": "This are wrong sentence"
      },
      "sample_output": {
        "original_text": "This are wrong sentence",
        "corrected_text": "This is a wrong sentence",
        "has_changes": true,
        "changes_summary": "Changed from 'This are wrong sentence' to 'This is a wrong sentence'",
        "errors_found": 1
      }
    },
    "10_grammar_check_batch": {
      "url": "POST http://localhost:6002/api/grammar/check",
      "description": "Grammar check for multiple texts (batch)",
      "sample_input": [
        {
          "text": "This are wrong"
        },
        {
          "text": "I has error"
        },
        {
          "text": "She go to school"
        }
      ],
      "sample_output": [
        {
          "original_text": "This are wrong",
          "corrected_text": "This is wrong",
          "has_changes": true,
          "changes_summary": "Changed from 'This are wrong' to 'This is wrong'",
          "errors_found": 1
        },
        {
          "original_text": "I has error",
          "corrected_text": "I have an error",
          "has_changes": true,
          "changes_summary": "Changed from 'I has error' to 'I have an error'",
          "errors_found": 2
        },
        {
          "original_text": "She go to school",
          "corrected_text": "She goes to school",
          "has_changes": true,
          "changes_summary": "Changed from 'She go to school' to 'She goes to school'",
          "errors_found": 1
        }
      ],
      "note": "Send an array of objects for batch processing. Each object must have a 'text' field. Uses LanguageTool locally."
    },
    "11_translation_translate_single": {
      "url": "POST http://localhost:6002/api/translation/translate",
      "description": "Translate single text to Arabic",
      "sample_input": {
        "text": "Gender: Women\nColor: Red\nMaterial: Cotton\nPattern: Floral"
      }
    },
    "12_translation_translate_batch": {
      "url": "POST http://localhost:6002/api/translation/translate",
      "description": "Translate multiple texts to Arabic",
      "sample_input": {
        "texts": [
          "Color: Blue",
          "Material: Cotton",
          "Size: Medium",
          "Gender: Men"
        ]
      }
    },
    "13_pipeline_process": {
      "url": "POST http://localhost:6002/api/pipeline/process",
      "description": "End-to-end: Classification -> Attributes -> Translation",
      "sample_input": {
        "item_name": "Abstract Blonde Mug",
        "description": "Multi-colored shimmering mug fusing abstract art with metallic luster. Base of yellowish-beige glazing with random infused shades of yellow, blue, green, metallic red and gold.",
        "item_department": "",
        "vendor_category": "",
        "images": [],
        "translate": true
      },
      "note": "Set translate=true to get Arabic translation, false to skip. Classification runs automatically — no need to pass shopping_category or item_category."
    },
    "14_pipeline_process_batch": {
      "url": "POST http://localhost:6002/api/pipeline/process-batch",
      "description": "Batch pipeline processing",
      "sample_input": {
        "items": [
          {
            "item_name": "It Girl Top in Beige",
            "description": "Party wear top for the it-girl",
            "vendor_category": "fashion",
            "images": []
          },
          {
            "item_name": "Chocolate Bar",
            "description": "Dark chocolate",
            "vendor_category": "groceries",
            "images": []
          }
        ],
        "translate": false
      }
    }
  }
}
